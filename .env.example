# 仅保存在本地，不提交 .env
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
# 可选：使用同一端点和密钥的视觉模型；兼容端点需显式指定。
AI_VISION_MODEL=
# macOS / Linux 可选指定 Chromium 或 Google Chrome 可执行文件
CHROME_PATH=
PORT=4173
# 运行 openssl rand -base64 32 生成私有密钥，填在本机 .env。
BETTER_AUTH_SECRET=
# Vite 开发入口可设为 http://localhost:5173；生产必须设置为公网 HTTPS Origin。
BETTER_AUTH_URL=http://localhost:5173
